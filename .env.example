# Copy to .env (git-ignored) and adapt: cp .env.example .env
# Local development values only: never reuse them in a shared environment.

# PostgreSQL
POSTGRES_DB=blankjava
POSTGRES_USER=blankjava
POSTGRES_PASSWORD=change-me-local-only

# Host port of PostgreSQL, bound to 127.0.0.1 only (for ./gradlew bootRun outside Docker)
POSTGRES_PORT=5432

# Project release shown in the footer and /actuator/info (images built by CI set the real one)
APP_RELEASE=local

# Host ports of the Nginx entry point. If you change HTTPS_PORT, the http -> https redirect
# still targets 443: open https://localhost:<HTTPS_PORT> directly.
HTTPS_PORT=443
HTTP_PORT=80

# JWT signing key (RS256). Create it once as infra/secrets/jwt-private.pem (git-ignored), see
# infra/README.md: compose.yaml mounts that folder into the backend, no variable is needed.
# During a key rotation, the previous public keys still accepted, as paths inside the container:
# JWT_PREVIOUS_PUBLIC_KEY_PATHS=/run/secrets/jwt/jwt-previous-public.pem

# Browser origins accepted on the session cookie endpoints (scheme://host[:port], comma-separated).
# Add the port if you changed HTTPS_PORT, e.g. https://localhost:8443
BLANKJAVA_ALLOWED_ORIGINS=https://localhost,https://frontend

# Nginx rate limit of /api/auth/* per client IP (infra/README.md, "Rate limiting"): sustained rate,
# extra requests allowed at once, and the Retry-After (seconds) of a 429, about 60 / requests per minute
NGINX_AUTH_RATE=10r/m
NGINX_AUTH_BURST=10
NGINX_AUTH_RETRY_AFTER=6
