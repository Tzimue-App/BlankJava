{
  "permissions": {
    "allow": [
      "Bash(./gradlew test*)",
      "Bash(./gradlew integrationTest*)",
      "Bash(./gradlew check*)",
      "Bash(./gradlew spotlessApply*)",
      "Bash(./gradlew spotlessCheck*)",
      "Bash(./gradlew compileTestJava*)",
      "Bash(gradlew.bat test*)",
      "Bash(gradlew.bat integrationTest*)",
      "Bash(gradlew.bat check*)",
      "Bash(gradlew.bat spotlessApply*)",
      "Bash(gradlew.bat spotlessCheck*)",
      "Bash(gradlew.bat compileTestJava*)",
      "Bash(npm run lint*)",
      "Bash(npm run format)",
      "Bash(npm run format:check*)",
      "Bash(npm run test:ci*)",
      "Bash(npm run build*)",
      "Bash(npm run generate*)",
      "Bash(npx --yes @stoplight/spectral-cli@6.17.0 lint api/openapi.yaml*)",
      "Bash(python -m pytest tests/*)",
      "Bash(python bump_version.py --check*)",
      "Bash(python bump_version.py --dry-run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run download*)",
      "Bash(gh api repos/{owner}/{repo}/statuses/*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh issue create*)",
      "Bash(python bump_version.py --start-milestone*)",
      "Bash(docker compose*down*-v*)",
      "Bash(docker compose*down*--volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env[a-zA-Z0-9_~-]*)",
      "Read(**/.env.[a-df-zA-DF-Z0-9_.~-]*)",
      "Read(**/.env.e[a-wyzA-WYZ0-9_.~-]*)",
      "Read(**/.env.ex[b-zB-Z0-9_.~-]*)",
      "Read(**/.env.exa[a-ln-zA-LN-Z0-9_.~-]*)",
      "Read(**/.env.exam[a-oq-zA-OQ-Z0-9_.~-]*)",
      "Read(**/.env.examp[a-km-zA-KM-Z0-9_.~-]*)",
      "Read(**/.env.exampl[a-df-zA-DF-Z0-9_.~-]*)",
      "Read(**/.env.example?*)",
      "Read(**/infra/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat *.env*)",
      "Bash(cat *infra/secrets*)",
      "Bash(cat *.pem*)",
      "Bash(cat *.key*)",
      "Bash(type *.env*)",
      "Bash(type *infra/secrets*)",
      "Bash(type *.pem*)",
      "Bash(type *.key*)",
      "Bash(head *.env*)",
      "Bash(head *infra/secrets*)",
      "Bash(head *.pem*)",
      "Bash(head *.key*)",
      "Bash(tail *.env*)",
      "Bash(tail *infra/secrets*)",
      "Bash(tail *.pem*)",
      "Bash(tail *.key*)",
      "Bash(less *.env*)",
      "Bash(less *infra/secrets*)",
      "Bash(less *.pem*)",
      "Bash(less *.key*)",
      "Bash(more *.env*)",
      "Bash(more *infra/secrets*)",
      "Bash(more *.pem*)",
      "Bash(more *.key*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *infra/secrets*)",
      "Bash(Get-Content *.pem*)",
      "Bash(Get-Content *.key*)",
      "Bash(grep *.env*)",
      "Bash(grep *infra/secrets*)",
      "Bash(grep *.pem*)",
      "Bash(grep *.key*)",
      "Bash(sed *.env*)",
      "Bash(sed *infra/secrets*)",
      "Bash(sed *.pem*)",
      "Bash(sed *.key*)",
      "Bash(awk *.env*)",
      "Bash(awk *infra/secrets*)",
      "Bash(awk *.pem*)",
      "Bash(awk *.key*)",
      "Bash(cp *.env*)",
      "Bash(cp *infra/secrets*)",
      "Bash(cp *.pem*)",
      "Bash(cp *.key*)",
      "Bash(base64 *.env*)",
      "Bash(base64 *infra/secrets*)",
      "Bash(base64 *.pem*)",
      "Bash(base64 *.key*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *infra/secrets*)",
      "PowerShell(Get-Content *.pem*)",
      "PowerShell(Get-Content *.key*)",
      "PowerShell(gc *.env*)",
      "PowerShell(gc *infra/secrets*)",
      "PowerShell(gc *.pem*)",
      "PowerShell(gc *.key*)",
      "PowerShell(cat *.env*)",
      "PowerShell(cat *infra/secrets*)",
      "PowerShell(cat *.pem*)",
      "PowerShell(cat *.key*)",
      "PowerShell(type *.env*)",
      "PowerShell(type *infra/secrets*)",
      "PowerShell(type *.pem*)",
      "PowerShell(type *.key*)",
      "PowerShell(Select-String *.env*)",
      "PowerShell(Select-String *infra/secrets*)",
      "PowerShell(Select-String *.pem*)",
      "PowerShell(Select-String *.key*)",
      "PowerShell(Copy-Item *.env*)",
      "PowerShell(Copy-Item *infra/secrets*)",
      "PowerShell(Copy-Item *.pem*)",
      "PowerShell(Copy-Item *.key*)",
      "Edit(./backend/build/**)",
      "Edit(./frontend/projects/web/src/app/core/api/generated/**)",
      "Edit(**/*.generated.ts)",
      "Bash(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *merges*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-frontend.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/spotless-stop.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
