# Images are built from the repository root (they need api/openapi.yaml):
#   docker build -f backend/Dockerfile .
# Keep the build context small and free of local state and secrets.
.git
.github
.idea
.vscode
docs
tests
**/build
**/.gradle
**/node_modules
**/dist
**/coverage
**/*.log
.env
.env.*
**/.env
**/.env.*
# Claude Code configuration and its worktrees (full copies of the repository, with .env and keys)
.claude
# JWT signing keys: mounted at runtime, never in an image
infra/secrets
**/*.pem
**/.angular
